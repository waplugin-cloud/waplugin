{
  "name": "@waplugin/plugin",
  "version": "0.3.0",
  "private": true,
  "description": "Permission-aware WhatsApp plugin manifests and skill resources.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/waplugin-cloud/waplugin.git"
  },
  "files": [
    "skills/**/*.md",
    ".claude-plugin/*.json",
    ".codex-plugin/*.json",
    "assets/*.svg",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "scripts/package-plugin.py"
  ],
  "exports": {
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "package:chatgpt": "python3 scripts/package-plugin.py"
  }
}
